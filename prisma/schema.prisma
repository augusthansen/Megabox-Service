// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  customer_admin
  customer_tech
  service_tech
}

enum PricingTier {
  basic
  standard
  mega
}

enum TicketStatus {
  open
  assigned
  in_progress
  on_hold
  resolved
  closed
}

enum ContactMethod {
  chat
  phone
  video
}

enum CallQueueStatus {
  waiting
  connected
  completed
  abandoned
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketCategory {
  mechanical       // Jams, feeder issues, transport problems
  electrical       // Power issues, motors, sensors
  software         // DirectConnect, firmware, configuration
  scanner_camera   // Barcode reading, OCR, vision system
  network          // Remote access, network connectivity
  consumables      // Ink, labels, envelopes
  training         // How-to questions, guidance needed
  preventive_maintenance  // Scheduled maintenance
  equipment_change // New machine added or machine removed
  other            // Doesn't fit above categories
}

enum SessionType {
  remote_support
  video_call
  research
  documentation
  chat
  phone_call
}

enum CommunicationRequestType {
  video_call
  phone_call
  chat
}

enum CommunicationRequestStatus {
  pending
  accepted
  declined
  scheduled
  in_progress
  completed
  cancelled
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  role             UserRole
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id])
  hubspotId        String?  @unique // HubSpot contact ID
  phone            String? // Phone number for calls
  isActive         Boolean  @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  createdTickets                Ticket[]               @relation("CreatedBy")
  assignedTickets               Ticket[]               @relation("AssignedTo")
  sessions                      Session[]
  attachments                   Attachment[]
  comments                      Comment[]
  primaryContactSites           Site[]                 @relation("SitePrimaryContact")
  communicationRequests         CommunicationRequest[]
  assignedCommunicationRequests CommunicationRequest[] @relation("AssignedTech")

  @@index([email])
  @@index([companyId])
  @@index([hubspotId])
}

model Company {
  id                     String      @id @default(cuid())
  name                   String
  email                  String? // Primary company email
  phone                  String? // Primary company phone
  hubspotId              String?     @unique
  pricingTier            PricingTier @default(basic)
  pricePerMachine        Decimal     @default(40)
  hourlyRate             Decimal     @default(180)
  currentMonthUsageHours Decimal     @default(0)
  currentMonthUsageCost  Decimal     @default(0)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  // Relations
  users    User[]
  sites    Site[]
  tickets  Ticket[]
  invoices Invoice[]

  @@index([hubspotId])
  @@index([email])
}

model Site {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  address          String?
  city             String?
  state            String?
  zipCode          String?
  timezone         String   @default("America/New_York")
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  primaryContactId String? // Main point of contact (User ID)
  primaryContact   User?    @relation("SitePrimaryContact", fields: [primaryContactId], references: [id])
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  machines         Machine[]
  tickets          Ticket[]
  floorPlan        FloorPlan?
  invoiceLineItems InvoiceLineItem[]

  @@index([companyId])
  @@index([primaryContactId])
}

model Machine {
  id                   String   @id @default(cuid())
  siteId               String
  site                 Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                 String
  model                String?
  series               String?
  serialNumber         String?
  windowsVersion       String?
  directConnectVersion String?
  firmwareVersion      String?
  configuration        Json? // Scanning, feeders, stations, etc.
  status               String?
  isCurrentlyDown      Boolean  @default(false)
  hasRemoteAccess      Boolean  @default(false)
  remoteAccessType     String?
  remoteAccessId       String?
  floorMapId           String?
  positionX            Float?
  positionY            Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  alarms           MachineAlarm[]
  tickets          Ticket[]
  floorPlanPosition MachinePosition?

  @@index([siteId])
  @@index([serialNumber])
}

model MachineAlarm {
  id               String    @id @default(cuid())
  machineId        String
  machine          Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  alarmCode        String
  alarmDescription String?
  occurrenceDate   DateTime  @default(now())
  resolvedDate     DateTime?
  resolution       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([machineId])
  @@index([alarmCode])
}

model Ticket {
  id             String         @id @default(cuid())
  ticketNumber   String         @unique
  hubspotId      String?        @unique
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  siteId         String
  site           Site           @relation(fields: [siteId], references: [id])
  machineId      String?
  machine        Machine?       @relation(fields: [machineId], references: [id])
  createdById    String
  createdBy      User           @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId   String?
  assignedTo     User?          @relation("AssignedTo", fields: [assignedToId], references: [id])
  subject        String
  description    String?
  category       TicketCategory?
  priority       TicketPriority @default(medium)
  status         TicketStatus   @default(open)
  contactMethod  ContactMethod?
  machineDown    Boolean        @default(false)
  totalMinutes   Int            @default(0)
  totalCost      Decimal        @default(0)
  escalationFees Decimal        @default(0) // Per-ticket escalation fees
  travelExpenses Decimal        @default(0) // Per-ticket travel expenses
  invoiceId      String? // Link to invoice if billed
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  // Resolution fields
  resolutionNotes String?       // Tech's description of what was done to resolve
  resolutionCategory String?    // Category of resolution (fixed, workaround, training, etc.)
  // Customer satisfaction
  satisfactionRating Int?       // 1-5 star rating from customer
  satisfactionFeedback String?  // Optional feedback text from customer
  satisfactionRatedAt DateTime? // When the rating was submitted
  createdAt      DateTime       @default(now())
  assignedAt     DateTime?
  startedAt      DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  updatedAt      DateTime       @updatedAt

  // Relations
  sessions              Session[]
  attachments           Attachment[]
  comments              Comment[]
  communicationRequests CommunicationRequest[]
  chatMessages          ChatMessage[]
  callQueue             CallQueue[]
  activityLogs          TicketActivityLog[]

  @@index([companyId])
  @@index([siteId])
  @@index([machineId])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([ticketNumber])
  @@index([invoiceId])
}

model Session {
  id                     String                @id @default(cuid())
  ticketId               String
  ticket                 Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  techId                 String
  tech                   User                  @relation(fields: [techId], references: [id])
  sessionType            SessionType
  startTime              DateTime
  endTime                DateTime?
  durationMinutes        Int?
  rateType               String? // "business", "after_hours", "weekend"
  rateAmount             Decimal?
  rateMultiplier         Decimal               @default(1)
  cost                   Decimal?
  videoRecordingUrl      String?
  callRecordingUrl       String? // Twilio call recording URL
  callRecordingSid       String? // Twilio recording SID
  callTranscription      String? // Call transcription text
  callTranscriptionSid   String? // Twilio transcription SID
  callResolutionStatus   String? // "resolved", "ongoing", "needs_followup"
  notes                  String?
  communicationRequestId String?               @unique
  communicationRequest   CommunicationRequest? @relation(fields: [communicationRequestId], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([ticketId])
  @@index([techId])
  @@index([communicationRequestId])
  @@index([callRecordingSid])
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([ticketId])
}

model Comment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  authorName String
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id])
  invoiceNumber       String        @unique
  billingPeriod       String // "2024-01" format
  machineCount        Int
  subscriptionFee     Decimal
  usageHours          Decimal
  usageFee            Decimal
  escalationFees      Decimal       @default(0) // Total from all tickets
  travelExpenses      Decimal       @default(0) // Total from all tickets
  totalAmount         Decimal
  status              InvoiceStatus @default(draft)
  paidDate            DateTime?
  quickbooksInvoiceId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  tickets   Ticket[] // Tickets included in this invoice
  lineItems InvoiceLineItem[] // Per-site breakdown

  @@index([companyId])
  @@index([invoiceNumber])
  @@index([billingPeriod])
}

model InvoiceLineItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id])
  machineCount    Int // Number of machines at this site
  subscriptionFee Decimal // Fee for this site (machines × price per machine)
  usageHours      Decimal  @default(0) // Total hours from tickets at this site
  usageFee        Decimal  @default(0) // Usage fee for this site
  escalationFees  Decimal  @default(0) // Total escalation fees from tickets at this site
  travelExpenses  Decimal  @default(0) // Total travel expenses from tickets at this site
  subtotal        Decimal // Total for this site
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([siteId])
}

model FloorPlan {
  id              String   @id @default(cuid())
  siteId          String   @unique  // One floor plan per site
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String   @default("Main Floor")
  width           Int      @default(1200)
  height          Int      @default(800)
  gridSize        Int      @default(25)  // Snap-to-grid size
  backgroundColor String   @default("#f5f5f5")
  showGrid        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  machinePositions MachinePosition[]
  textLabels       FloorPlanLabel[]

  @@index([siteId])
}

// Text labels for floor plans
model FloorPlanLabel {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  text        String
  x           Float
  y           Float
  fontSize    Int       @default(16)
  fontWeight  String    @default("normal")  // "normal" or "bold"
  color       String    @default("#374151")  // Text color
  rotation    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([floorPlanId])
}

model MachinePosition {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  machineId   String    @unique
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  x           Float
  y           Float
  width       Float     @default(120)
  height      Float     @default(80)
  rotation    Float     @default(0)
  label       String?   // Optional custom label
  shapeId     String?   // Custom shape to use
  shape       MachineShape? @relation(fields: [shapeId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([floorPlanId, machineId])  // Each machine only once per floor plan
  @@index([floorPlanId])
  @@index([machineId])
  @@index([shapeId])
}

// Custom machine shapes for floor plans
model MachineShape {
  id          String   @id @default(cuid())
  name        String   // Display name (e.g., "Bluecrest Elevate")
  points      Json     // Array of {x, y} normalized points (0-1 range)
  inputArrow  Json?    // {x, y, direction} for input flow arrow
  outputArrow Json?    // {x, y, direction} for output flow arrow
  color       String   @default("#06b6d4")  // Shape color (hex)
  isDefault   Boolean  @default(false)  // If true, this is a system default shape
  createdById String?  // User who created it (null for system defaults)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  machinePositions MachinePosition[]

  @@index([name])
  @@index([isDefault])
}

model CommunicationRequest {
  id            String                     @id @default(cuid())
  ticketId      String
  ticket        Ticket                     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedById String // Customer who requested
  requestedBy   User                       @relation(fields: [requestedById], references: [id])
  assignedToId  String? // Tech assigned to handle
  assignedTo    User?                      @relation("AssignedTech", fields: [assignedToId], references: [id])
  requestType   CommunicationRequestType
  status        CommunicationRequestStatus @default(pending)
  scheduledTime DateTime? // When the call is scheduled
  customerPhone String? // Phone number for phone calls
  notes         String? // Additional notes from customer
  techNotes     String? // Notes from tech
  sessionId     String?                    @unique // Link to Session if completed
  session       Session?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  acceptedAt    DateTime?
  completedAt   DateTime?

  @@index([ticketId])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledTime])
}

model ChatMessage {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  // File attachment fields
  attachmentUrl  String?  // URL to the uploaded file (Supabase storage)
  attachmentType String?  // MIME type (image/png, video/mp4, application/pdf, etc.)
  attachmentName String?  // Original filename
  attachmentSize Int?     // File size in bytes
  createdAt      DateTime @default(now())

  @@index([ticketId])
  @@index([senderId])
}

model CallQueue {
  id               String          @id @default(cuid())
  ticketId         String
  ticket           Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customerId       String
  techId           String?
  position         Int
  status           CallQueueStatus @default(waiting)
  estimatedWait    Int? // Estimated wait in minutes
  customerPhone    String?
  callbackRequested Boolean        @default(false)
  videoCallActive  Boolean         @default(false)
  videoRoomUrl     String?
  joinedAt         DateTime        @default(now())
  connectedAt      DateTime?
  completedAt      DateTime?
  updatedAt        DateTime        @updatedAt

  @@index([ticketId])
  @@index([customerId])
  @@index([techId])
  @@index([status])
}

enum NotificationType {
  ticket_assigned       // Tech assigned to a ticket
  ticket_status_change  // Ticket status updated
  new_chat_message      // New chat message received
  communication_request // Customer requested call/video/chat
  queue_update          // Queue position changed
  ticket_created        // New ticket created
  priority_change       // Ticket priority changed
  ticket_resolved       // Ticket was resolved (for customer to rate)
  system                // System announcements
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           // User who receives the notification
  type        NotificationType
  title       String
  message     String
  link        String?          // URL to navigate to when clicked
  ticketId    String?          // Optional reference to related ticket
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// Activity log for tracking all changes to a ticket
enum ActivityType {
  created
  status_change
  priority_change
  assignment_change
  comment_added
  chat_message
  video_call_started
  video_call_ended
  phone_call_started
  phone_call_ended
  file_uploaded
  resolution_added
  satisfaction_rated
  edited
}

model TicketActivityLog {
  id           String       @id @default(cuid())
  ticketId     String
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId      String?      // User who performed the action (null for system)
  actorName    String       // Name of who performed action
  activityType ActivityType
  description  String       // Human-readable description
  oldValue     String?      // Previous value (for changes)
  newValue     String?      // New value (for changes)
  metadata     Json?        // Additional data (e.g., file info, session details)
  createdAt    DateTime     @default(now())

  @@index([ticketId])
  @@index([actorId])
  @@index([activityType])
  @@index([createdAt])
}

// ==========================================
// KNOWLEDGE BASE SYSTEM
// ==========================================

// Document types for categorization
enum DocumentType {
  service_manual      // Full service manuals
  parts_manual        // Parts catalogs/manuals
  procedures          // Procedures documents
  tsb                 // Technical Service Bulletins
  quick_reference     // Quick reference guides
  troubleshooting     // Troubleshooting guides
  installation        // Installation guides
  maintenance         // Maintenance schedules/procedures
  wiring_diagram      // Electrical/wiring diagrams
  other               // Other documents
}

// Processing status for documents
enum ProcessingStatus {
  pending             // Uploaded, waiting to be processed
  processing          // Currently being processed
  completed           // Successfully processed
  failed              // Processing failed
}

// Uploaded documents (PDFs, manuals, etc.)
model KnowledgeDocument {
  id              String           @id @default(cuid())
  title           String           // Document title
  fileName        String           // Original filename
  fileUrl         String           // URL to the stored file (S3/Supabase Storage)
  fileSize        Int              // File size in bytes
  mimeType        String           // MIME type (application/pdf, etc.)
  documentType    DocumentType     @default(other)

  // Categorization
  manufacturer    String?          // Machine manufacturer (e.g., "Formax", "Quadient")
  machineModel    String?          // Specific machine model
  machineModels   String[]         // Multiple applicable models
  category        String?          // Custom category
  tags            String[]         // Searchable tags

  // Metadata
  description     String?          // Brief description
  documentNumber  String?          // Official document number (if applicable)
  revision        String?          // Document revision/version
  documentDate    DateTime?        // Date on the document
  pageCount       Int?             // Number of pages

  // Processing
  status          ProcessingStatus @default(pending)
  processingError String?          // Error message if processing failed
  processedAt     DateTime?        // When processing completed
  totalChunks     Int?             // Total chunks to process
  processedChunks Int?             // Chunks processed so far

  // Ownership
  uploadedById    String
  uploadedByName  String
  isPublished     Boolean          @default(true)

  // Stats
  viewCount       Int              @default(0)
  downloadCount   Int              @default(0)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  chunks          DocumentChunk[]

  @@index([documentType])
  @@index([manufacturer])
  @@index([machineModel])
  @@index([status])
  @@index([isPublished])
  @@index([tags])
}

// Document chunks for vector search (RAG)
// Each document is split into smaller chunks for better search
model DocumentChunk {
  id            String            @id @default(cuid())
  documentId    String
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content       String            // Text content of this chunk
  chunkIndex    Int               // Order of chunk within document
  pageNumber    Int?              // Page number in original document
  heading       String?           // Section heading if available

  // Vector embedding stored as JSON array (will use pgvector extension)
  // For now storing as JSON, can migrate to vector type later
  embedding     Json?             // OpenAI embedding vector
  embeddingModel String?          // Model used for embedding (e.g., "text-embedding-3-small")

  // Metadata for filtering
  metadata      Json?             // Additional chunk metadata

  createdAt     DateTime          @default(now())

  @@index([documentId])
  @@index([chunkIndex])
  @@index([pageNumber])
}

// Knowledge Base chat conversations
model KnowledgeChatSession {
  id            String                  @id @default(cuid())
  userId        String
  userName      String
  ticketId      String?                 // Optional link to a ticket
  title         String?                 // Auto-generated title from first message

  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  messages      KnowledgeChatMessage[]

  @@index([userId])
  @@index([ticketId])
  @@index([createdAt])
}

// Individual chat messages
model KnowledgeChatMessage {
  id            String               @id @default(cuid())
  sessionId     String
  session       KnowledgeChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role          String               // "user" or "assistant"
  content       String               // Message content

  // For assistant messages - source citations
  citations     Json?                // Array of {documentId, chunkId, pageNumber, snippet}

  // Feedback
  wasHelpful    Boolean?             // User feedback on response

  createdAt     DateTime             @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// Knowledge Base for storing manual articles/solutions
model KnowledgeBaseArticle {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique // URL-friendly identifier
  content       String   // Markdown content
  summary       String?  // Brief summary for search results
  category      String   // Category (e.g., "Mechanical", "Software", "Network")
  tags          String[] // Array of tags for searching
  machineModels String[] // Applicable machine models
  authorId      String
  authorName    String
  isPublished   Boolean  @default(false)
  viewCount     Int      @default(0)
  helpfulCount  Int      @default(0) // Number of "this helped" clicks
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([slug])
}

// Link knowledge base articles to tickets (for suggested solutions)
model TicketKnowledgeLink {
  id        String   @id @default(cuid())
  ticketId  String
  articleId String
  linkedById String  // Who linked this article
  wasHelpful Boolean? // Did it help resolve the issue?
  createdAt DateTime @default(now())

  @@unique([ticketId, articleId])
  @@index([ticketId])
  @@index([articleId])
}
